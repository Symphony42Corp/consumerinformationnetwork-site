modules = ["nodejs-20"]
run = ["npx", "--yes", "serve@14", "dist", "-l", "5000", "-n"]

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "static"
publicDir = "dist"

[[deployment.rewrites]]
from = "/auto-insurance/call"
to = "/auto-insurance/call.html"

[[deployment.rewrites]]
from = "/auto-insurance/call/"
to = "/auto-insurance/call.html"

[[deployment.rewrites]]
from = "/about"
to = "/about.html"

[[deployment.rewrites]]
from = "/about/"
to = "/about.html"

