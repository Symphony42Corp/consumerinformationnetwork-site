---
// PRIVACY POLICY — the live policy text is preserved verbatim from
// https://www.consumerinformationnetwork.com/privacy-policy (captured Sept 2, 2026).
// Only the "Vertical-Specific Information" subsection is new. Three existing passages are
// flagged for counsel review with HTML comments; the wording itself is unchanged.
import BaseLayout from '../layouts/BaseLayout.astro';
import legal from '../data/legal.json';
const blocks = legal.privacy as { tag: string; text: string }[];

const flags: Record<string, string> = {
  'annual third-party security audits': 'COUNSEL REVIEW REQUIRED: confirm annual third-party security audits are performed and documented; otherwise soften to commercially reasonable safeguards (see BUILD_NOTES.md).',
  'retained indefinitely': 'COUNSEL REVIEW REQUIRED: "retained indefinitely" — recommended reformulation to retention for as long as reasonably necessary (see BUILD_NOTES.md).',
  'protected health information': 'COUNSEL REVIEW REQUIRED: confirm the no-PHI statement remains accurate as Senior Care Information Network launches (see BUILD_NOTES.md).',
};
const insertAfter = 'We do not ask for or intentionally collect Social Security numbers';
---
<BaseLayout
  title="Privacy Policy — Consumer Information Network"
  description="How Consumer Information Network, LLC collects, uses, and protects personal information."
  path="/privacy-policy"
>
  <section class="section">
    <div class="wrap"><div class="prose legal">
      <h1>Privacy Policy</h1>
      {blocks.map((b) => {
        const flag = Object.keys(flags).find((k) => b.text.includes(k));
        const el = b.tag === 'h2'
          ? null
          : b.tag === 'h3'
            ? <h3>{b.text}</h3>
            : b.tag === 'li'
              ? <ul class="bullets"><li>{b.text}</li></ul>
              : <p>{b.text}</p>;
        return (
          <>
            {flag && <Fragment set:html={`<!-- ${flags[flag]} -->`} />}
            {el}
            {b.text.startsWith(insertAfter) && (
              <div class="added">
                <h3>Vertical-Specific Information</h3>
                <p>Depending on the Information Network you use, you may choose to provide category-specific information such as vehicle details, property details, insurance interests, approximate debt-related information, final expense planning preferences, senior-care preferences, state of residence, timing, budget ranges, or other details relevant to your request. We use this information to provide AI-generated general information, improve routing, and, when you request it, help connect you with an independent participating provider or resource. We do not collect protected health information through AI Agent interactions.</p>
              </div>
            )}
          </>
        );
      })}
    </div></div>
  </section>
</BaseLayout>
