---
import '@fontsource/instrument-serif';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource-variable/manrope';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  path: string;          // e.g. "/about"
  jsonLd?: Record<string, unknown>;
}
const { title, description, path, jsonLd } = Astro.props;
const site = 'https://www.consumerinformationnetwork.com';
const canonical = site + (path === '/' ? '/' : path);
const ogImage = site + '/images/og-default.png';

const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Consumer Information Network',
  legalName: 'Consumer Information Network, LLC',
  url: site + '/',
  logo: site + '/icon-512.png',
  parentOrganization: { '@type': 'Corporation', name: 'Symphony42 Corporation', url: 'https://www.symphony42.com/' },
  address: { '@type': 'PostalAddress', streetAddress: '2 Village Square, Suite 220', addressLocality: 'Baltimore', addressRegion: 'MD', postalCode: '21210', addressCountry: 'US' },
  telephone: '+1-410-357-1232',
  email: 'info@consumerinformationnetwork.com',
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/icon-512.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#1B76EA" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Consumer Information Network" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd ?? org)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header path={path} />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
