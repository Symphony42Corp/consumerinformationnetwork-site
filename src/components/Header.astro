---
interface Props { path: string }
const { path } = Astro.props;
const links = [
  { href: '/', label: 'Home' },
  { href: '/information-networks', label: 'Information Networks' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
---
<header class="nav-wrap">
  <div class="wrap">
    <nav class="nav" aria-label="Primary">
      <a class="brand" href="/">
        <img src="/images/cin-mark.png" alt="Consumer Information Network mark" width="40" height="40" />
        <span>Consumer Information Network</span>
      </a>
      <!-- Mobile menu: CSS-only toggle. The checkbox is visually hidden but keyboard-focusable. -->
      <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label="Open menu" />
      <label for="nav-toggle" class="menu-btn" title="Menu"><span class="menu-bars" aria-hidden="true"><i></i><i></i><i></i></span><span class="menu-text">Menu</span></label>
      <ul class="nav-links">
        {links.map((l) => (
          <li><a class="link" href={l.href} aria-current={path === l.href ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>
