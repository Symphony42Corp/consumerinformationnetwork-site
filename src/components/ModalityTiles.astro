---
// Three ways to reach an AI Agent — Call / Text / Avatar. Generic across every network.
const bars = [8, 14, 22, 30, 18, 26, 34, 20, 12, 24, 30, 16, 10, 20, 28, 14, 8, 18, 26, 12, 22, 30, 16, 10];
---
<div class="grid-3" aria-label="Three ways to reach an AI Agent">
  <div class="tile">
    <h3>Call</h3>
    <div class="vig" aria-hidden="true">
      <div style="font-weight:700;color:var(--ink);margin-bottom:.6rem">AI Agent</div>
      <div class="wave">{bars.map((h, i) => <i style={`height:${h}px;--i:${i};--k:${i % 3}`}></i>)}</div>
      <div class="quiet" style="text-align:center;margin-top:.6rem">00:42</div>
    </div>
  </div>
  <div class="tile">
    <h3>Text</h3>
    <div class="vig" aria-hidden="true">
      <div class="thread" data-typing-thread>
        <div class="bubble user"><span data-typed>What should I know before I decide?</span></div>
        <div class="agent-row">
          <img src="/images/cin-mark.png" alt="" width="34" height="34" />
          <div class="bubble agent"><div class="agent-label">AI Agent</div><span data-typed>Here is the simple version.</span></div>
        </div>
      </div>
    </div>
  </div>
  <div class="tile">
    <h3>Avatar</h3>
    <div class="vig" style="padding:0;overflow:hidden">
      <div class="avatar-tile">
        <span class="live">AI Agent</span>
        <picture>
          <source type="image/webp" srcset="/images/avatar-agent.webp" />
          <img src="/images/avatar-agent.jpg" alt="A smiling AI Agent avatar at a help desk" width="720" height="450" loading="lazy" />
        </picture>
      </div>
    </div>
  </div>
</div>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const thread = document.querySelector('[data-typing-thread]');
  if (thread && !reduce) {
    const spans = Array.from(thread.querySelectorAll('[data-typed]'));
    const texts = spans.map((el) => el.textContent || '');
    // reserve the final height so bubbles don't jump while typing
    // reserve the final size so bubbles don't jump while typing — width is capped so it can never exceed the thread
    spans.forEach((el) => { const b = el.closest('.bubble'); if (b) { const cap = Math.floor(thread.clientWidth * 0.86); b.style.minHeight = b.offsetHeight + 'px'; b.style.width = Math.min(b.offsetWidth, cap) + 'px'; b.style.maxWidth = '86%'; } });
    const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
    const type = async (el, text, speed) => {
      el.classList.add('typing');
      for (let i = 1; i <= text.length; i++) { el.textContent = text.slice(0, i); await sleep(speed + Math.random() * 30); }
      el.classList.remove('typing');
    };
    const dots = (el) => { el.classList.add('dots'); el.textContent = ''; };
    (async () => {
      while (true) {
        spans.forEach((el) => { el.textContent = ''; el.classList.remove('dots', 'typing'); });
        await sleep(700);
        await type(spans[0], texts[0], 42);
        await sleep(600);
        dots(spans[1]);
        await sleep(1100);
        spans[1].classList.remove('dots');
        await type(spans[1], texts[1], 34);
        await sleep(4200);
      }
    })();
  }
</script>
